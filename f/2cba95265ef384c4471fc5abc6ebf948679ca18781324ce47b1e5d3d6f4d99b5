function prioLoads(){ const L={}, wh=workHours(); for(const m of S.machines){ if(!m.placed) continue; let h=remH(m); for(const id of m.queue){ const o=ordGet(id); if(o&&(o.prio||o.manual||o.pin)) h+=planH(m,o); } L[m.id]=h+(isDown(m)?Math.max(0,(m.down-S.t)/1440)*wh:(!airOk(m)||powerOff(m))?wh:0); } return L; }
function jitEta(o){ const L=o.prio?prioLoads():machineLoads(), wh=workHours(); let d=null; for(const m of S.machines.filter(m=>m.placed&&canDo(m,o)[0])){ const x=(L[m.id]||0)/wh; if(d==null||x<d) d=x; } return Math.max(1,Math.ceil(d??3)); }
function jitDay(){ const P=S.orders.filter(o=>o.matPend).sort((a,b)=>!!b.prio-!!a.prio||a.due-b.due); if(!P.length) return; const L0=machineLoads(), LP=P.some(o=>o.prio)?prioLoads():null, wh=workHours();
  for(const o of P){ const L=o.prio?LP:L0; let best=null; for(const m of S.machines.filter(m=>m.placed&&canDo(m,o)[0])) if(!best||(L[m.id]||0)<(L[best.id]||0)) best=m;
    const days=best?(L[best.id]||0)/wh:0, jh=best?planH(best,o):0; o.matDay=S.day+Math.max(1,Math.ceil(days));
    if(days<=(ownMat()&&(!o.matPref||o.matPref==='kendi')?2:3)||S.day>=o.due-Math.ceil(jh/wh)-5){ const r=buyMat(o,o.matPref);
      if(r){ o.matPend=false; o.matCost=r.mc; o.matSup=r.ms; o.matDay=S.day+r.lead; if(r.lead===0) o.st='hazir'; toast(`📦 ${partTitle(o)}: sırası geldi, malzeme alındı (${fmt$(r.mc)} · ${r.how})`); }
      else if((o.matWarn||0)<S.day-3){ o.matWarn=S.day; popup('📦','Malzeme alınamadı',`${partTitle(o)} işinin sırası geldi ama malzeme alınamadı: kasada para yok ve vadeli veren malzemeci kalmadı. Borçları kapatınca malzeme otomatik alınır.`); } }
    if(best) L[best.id]=(L[best.id]||0)+jh; } }
function buyMat(o,sup){
  syncPlant(); if(sup==='hizir'&&MSUP.kendi) sup='kendi'; const ms=(sup&&MSUP[sup]&&!onHold('mat_'+sup))?sup:pickMatSup(), base=materialCost(o); let mc, how, lead;
  const kp=o.big?(1-facUps((S.facs&&S.facs.mat)||{}).reduce((a,u)=>a+(u.bigDisc||0),0)):MSUP.kendi?MSUP.kendi.price:1; if(ms==='kendi'){ mc=Math.round(base*kp); lead=0; if(mc>0) bill(mc,'Malzeme (kendi deponuzdan)',partTitle(o),undefined,'kendi'); const f=S.facs.mat; f.saved=(f.saved||0)+Math.round(base-mc); how=`kendi deponuzdan, aynı gün, ${ownMatDays()} gün vadeli`; }
  else if(ms&&ms!=='kendi'){ mc=Math.round(base*MSUP[ms].price); lead=MSUP[ms].lead; bill(mc,'Malzeme',partTitle(o),undefined,ms); how=`${MSUP[ms].n}, ${CFG.supplierDays??30} gün vadeli`; }
  else if(ms==='kendi'){ const alt=['ekol','marmara','hizir'].find(k=>!onHold('mat_'+k)); if(alt){ mc=Math.round(base*MSUP[alt].price); lead=MSUP[alt].lead; bill(mc,'Malzeme',partTitle(o),undefined,alt); how=`${MSUP[alt].n} (kasada para yok)`; } else { mc=Math.round(base*1.05); cash(-mc,'Malzeme (peşin)',partTitle(o)); lead=1; how='peşin'; } }
  else { mc=Math.round(base*1.05); if(avail()<mc) return false; cash(-mc,'Malzeme (peşin)',partTitle(o)); lead=1; how='peşin, vadeli veren malzemeci yok'; }
  return {mc,how,lead,ms:ms||'pesin',base}; }
function assign(oid,mid){ const o=ordGet(oid), m=mGet(mid); if(!o||!m) return;
  o.st='sirada'; o.mid=mid; o.manual=true; m.queue.push(oid); closeSheet(); toast(`${MODELS[m.model].name} sırasına eklendi`); saveAll(); render(); }
