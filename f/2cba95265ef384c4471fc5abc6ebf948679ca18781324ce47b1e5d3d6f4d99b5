const PB_CURVE=[[55e3,4.5],[180e3,4],[300e3,2.2],[600e3,2],[1.5e6,1.8],[5e6,1.5]];
function payTgt(P){ const C=PB_CURVE; if(P<=C[0][0]) return C[0][1]; for(let i=1;i<C.length;i++) if(P<=C[i][0]){ const [a,ta]=C[i-1],[b,tb]=C[i]; return ta+(tb-ta)*Math.log(P/a)/Math.log(b/a); } return C[C.length-1][1]; }
