function facLoan(price){ return loanCalc(price,20,60); }
function facLoanTxt(price){ const lc=facLoan(price); return `Krediyle · peşinat ${fmt$(lc.down)} · 60 ay × ${fmt$(lc.monthly)}`; }
function facCredit(name,price){ const lc=facLoan(price); S.leases.push({kind:'kredi',name:name+' yatırım kredisi',monthly:lc.monthly,left:lc.term,next:S.day+30,rate:CFG.loanRate??12}); return lc; }
function buyFac(k,credit){ const F=FAC[k], cur=facS()[F.g], up=cur&&k==='mat_l'&&cur.k==='mat_s', price=up?F.price-Math.round(FAC.mat_s.price*0.85):F.price, pay=credit?facLoan(price).down:price;
  if(cur&&!up) return; if(S.money<pay){ toast('Para yetmiyor'); return; }
  cash(-pay,credit?'Tesis alımı (peşinat)':'Tesis alımı',F.n); if(credit) facCredit(F.n,price); facS()[F.g]=up?{...cur,k}:{k,since:S.day,last:S.day,saved:0,inc:0,loc:(S.shop&&S.shop.loc)||pick(LOCS.filter(l=>isOSB(l)))};
  syncPlant(); toast(`${F.ic} ${facName(k)} (${F.n}) ${up?'büyütüldü':'kuruldu'}${F.g==='mat'?' · malzeme artık kendi deponuzdan':''}`); saveAll(); render(); }
function facValue(f){ return FAC[f.k].price+facUps(f).reduce((a,u)=>a+u.price,0); }
function facSellV(f){ return Math.round(facValue(f)*0.85/1000)*1000; }
function sellFac(g){ const f=facS()[g]; if(!f) return; const F=FAC[f.k], v=facSellV(f); if(sellFac.arm!==g||Date.now()-sellFac.t>5000){ sellFac.arm=g; sellFac.t=Date.now(); toast(`Satmak için 5 sn içinde tekrar dokun: ${F.n} · ${fmt$(v)}`); return; } sellFac.arm=null; cash(v,'Tesis satışı',F.n); delete facS()[g]; syncPlant(); if(CFG.matSup==='kendi') CFG.matSup='ekol'; toast(`${F.n} ${fmt$(v)}'a satıldı`); saveAll(); render(); }
function facDay(){ for(const [g,f] of Object.entries(facS())){ const F=FAC[f.k]; if(!F||S.day-f.last<30) continue; f.last=S.day;
    const mk=(S.market&&S.market.low?0.75:1)*(crisisOn()?0.7:1)*facAge(f), U=facUps(f), inc=Math.round((r2(F.sales[0],F.sales[1])*(1+0.08*(f.extra||0))+U.reduce((a,u)=>a+r2(u.sales[0],u.sales[1]),0))*mk/50)*50, ox=facOpex(f); f.inc=(f.inc||0)+inc; f.lastInc=inc;
    cash(inc,`${F.n}: dış satış kârı`,f.loc||''); cash(-ox,`${F.n}: personel + gider`,f.loc||'');
    toast(`${F.ic} ${F.n}: bu ay dışarıya satıştan ${fmt$(inc)} kâr, gider ${fmt$(ox)}`); } }
