  for(const o of S.offers){ if(rivSkip(o)) continue;
    const attr=offerAttr(o);
    for(const x of info.slice().sort(()=>Math.random()-0.5)){ if(attr<x.th||x.b.cash<-rbFix(x.b)*40) continue;
      if(Math.random()<rivP1(x,o,attr)*cf&&x.ks.some(k=>canDo({model:k},o)[0])){ gone.add(o); rbAddJob(x.b,o,'pano'); by[x.b.id]=(by[x.b.id]||0)+1; x.need=Math.max(0.05,x.need-0.15); break; } } }
