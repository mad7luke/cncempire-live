function treeRing(a,off,st){ const P=[], x0=a.x+off, y0=a.y+off, x1=a.x+a.w-1-off, y1=a.y+a.d-1-off; if(x1<x0||y1<y0) return P;
  for(let x=x0;x<=x1+1e-6;x+=st) P.push([x,y0]); for(let y=y0+st;y<=y1+1e-6;y+=st) P.push([x1,y]); if(y1>y0) for(let x=x1-st;x>=x0-1e-6;x-=st) P.push([x,y1]); if(x1>x0) for(let y=y1-st;y>y0+1e-6;y-=st) P.push([x0,y]); return P; }
