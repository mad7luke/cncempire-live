// ===================== PERSONEL MORALİ, İK, YEMEK, ÇAY MOLASI =====================
// moral 0-100. Duygusal personel düşük moralde çok daha fazla hata yapar ve daha sık gelmez.
function morOf(p){ if(p.mor==null){ p.mor=70; } if(p.emo==null){ const h=hash01('emo'+p.id+p.name); p.emo=p.duy?13+Math.floor(h*8):1+Math.floor(h*12); } p.duy=p.emo>=14; if(p.bday==null) p.bday=1+Math.floor(hash01('bd'+p.id+p.name)*365); return p.mor; }
// duygusallık (1-20): moral daha çabuk bozulur, düşük moralde hata ve devamsızlık daha çok artar
function emoF(p){ morOf(p); return 0.55+p.emo/20; }
function ikMan(){ return present('ik').sort((a,b)=>CA(b)-CA(a))[0]||null; }
function ikQ(){ const p=ikMan(); return p?0.5+CA(p)/200:0; }
function morErr(p){ const m=morOf(p); return m>=60?1:1+(60-m)/60*(0.2+p.emo/20*1.2); }
function morAbs(p){ if(p.role==='owner') return 1; const m=morOf(p); return m>=50?1:1+(50-m)/25*(0.6+p.emo/25); }
function moraleErrF(){ const c=crew().filter(p=>p.role!=='owner'); if(!c.length) return 1; return c.reduce((a,p)=>a+morErr(p),0)/c.length; }
function teaNow(){ if(CFG.tea===false||!S.shop) return false; const m=S.t%1440; return (m>=600&&m<615)||(m>=900&&m<915); }
function staffNO(){ return S.staff.filter(p=>p.role!=='owner'); }
function avgMor(){ const L=staffNO(); return L.length?L.reduce((a,p)=>a+morOf(p),0)/L.length:70; }
const MORC=['#ff5d5d','#ff9b42','#f5c542','#9bd35a','#3ecf8e'];
function morBars(m){ const n=clamp(Math.ceil(m/20),1,5), c=MORC[n-1]; let h=''; for(let i=0;i<5;i++) h+=`<i style="display:inline-block;width:5px;height:${6+i*2}px;margin-right:2px;border-radius:1px;background:${i<n?c:'#3a4049'}"></i>`; return `<span style="display:inline-flex;align-items:flex-end;vertical-align:-1px">${h}</span>`; }
function morFace(p){ const m=morOf(p); return `${morBars(m)} <span style="color:${MORC[clamp(Math.ceil(m/20),1,5)-1]}">${Math.round(m)}</span>`; }
function morAdd(p,v){ morOf(p); p.mor=clamp(p.mor+v,0,100); }
function morAll(v,ex){ for(const p of staffNO()) if(p!==ex) morAdd(p,v<0?v*emoF(p):v); }
function payroll(){ return staffNO().reduce((a,p)=>a+p.salary,0); }
function peerAvg(p){ const L=staffNO().filter(x=>x.role===p.role&&x!==p); return L.length?L.reduce((a,x)=>a+x.salary,0)/L.length:null; }
function moraleDay(){ if(!S.shop) return; const ik=ikQ(), tgt=65+ik*8, neg=ik?1-0.4*ik:1, night=!!(S.upgrades&&S.upgrades.night);
  for(const p of staffNO()){ morOf(p); let d=(tgt-p.mor)*0.03;
    const ef=emoF(p), mk=salaryOf(p); if(p.salary<mk*0.92) d-=0.6*neg*ef; if(needOSS(p)&&p.ossOff) d-=0.8*ef;
    const pa=peerAvg(p); if(pa&&pa>p.salary*1.3) d-=0.4*neg*ef;
    if(night&&p.role==='op') d-=0.15*neg*ef; if(CFG.tea===false) d-=0.4*neg*ef;
    if(decorF()<1) d+=(1-decorF())*2;
    if(strikeOn()) d-=0.3*ef;
    p.mor=clamp(p.mor+d,0,100);
    if(p.mor<20){ p.lowN=(p.lowN||0)+1; if(p.lowN>=12&&Math.random()<0.15){ S.staff=S.staff.filter(x=>x!==p); morAll(-3); popup('🚪','İstifa',`${p.name} istifa etti: “Burada artık mutlu değilim.” Morali uzun süredir çok düşüktü${p.emo>=14?' (duygusal biriydi)':''}. Diğerlerinin morali de biraz düştü.`); continue; } } else p.lowN=0; }
  // doğum günleri
  const doy=((S.day-1)%365)+1;
  for(const p of staffNO()) if(p.bday===doy&&!(S.bdDone&&S.bdDone[p.id]===S.day)){ (S.bdDone=S.bdDone||{})[p.id]=S.day;
    if(ikMan()&&S.money>0){ const c=cakeCost(); cash(-c,'Doğum günü pastası',p.name); morAdd(p,10); morAll(2,p); toast(`🎂 ${p.name}'in doğum günü: İK pastayı ısmarladı (${fmt$(c)})`); }
    else { S.bdToday={pid:p.id,day:S.day}; popup('🎂','Doğum günü',`Bugün ${p.name}'in doğum günü. Mağaza › 🍽️ Yemek sekmesinden pasta ısmarlayabilirsin (${fmt$(cakeCost())}). Unutursan ${p.emo>=14?'çok ':''}alınır.`); } }
  if(S.bdToday&&S.bdToday.day<S.day){ const p=S.staff.find(x=>x.id===S.bdToday.pid); if(p&&!S.bdToday.done) morAdd(p,-Math.round(4+p.emo/3)); S.bdToday=null; }
  // zam talebi: patron çok kazanınca
  const pr=payroll(); S.lastRaise=S.lastRaise??S.day;
  if(!S.zam&&!strikeOn()&&pr>0&&staffNO().length>=3&&S.day-S.lastRaise>=180&&(S.money>Math.max(40000,pr*6)||(S.carBuy&&S.day-S.carBuy<30&&S.money>pr*2))){
    const rich=S.money/Math.max(1,pr), pct=clamp(Math.round(5+rich/4),6,15);
    S.zam={pct,day:S.day,until:S.day+7}; popup('✊','Zam talebi',`Personel toplandı: “İşler iyi gidiyor, patron ${S.carBuy&&S.day-S.carBuy<60?'yeni araba aldı':'iyi kazanıyor'}. Maaşlara %${pct} zam istiyoruz.” 7 gün içinde cevap ver (Ana sayfa). Cevap vermezsen reddetmiş sayılırsın.`); }
  if(S.zam&&S.day>S.zam.until) zamAnswer('red');
  if(S.strike&&S.day>=S.strike.until){ S.strike=null; morAll(4); popup('🤝','Grev bitti','Personel işe döndü. Moraller hâlâ kırgın; bir yemek ısmarlamak iyi gelebilir.'); }
  if(S.strikeAt&&S.day>=S.strikeAt){ S.strikeAt=null; S.strike={day:S.day,until:S.day+ri(2,4),pct:S.strikePct||10}; popup('🪧','Grev',`Personel greve gitti: makineler operatörsüz duruyor. Grev ${S.strike.until-S.day} gün sürecek ya da Ana sayfadan zam vererek bitirebilirsin.`); } }
function strikeOn(){ return !!(S.strike&&S.day<S.strike.until); }
function zamAnswer(a){ const Z=S.zam; if(!Z) return; S.zam=null; S.lastRaise=S.day; const ik=ikQ();
  if(a==='evet'){ for(const p of staffNO()) p.salary=Math.round(p.salary*(1+Z.pct/100)/50)*50; morAll(15); popup('🤝','Zam verildi',`Bütün maaşlara %${Z.pct} zam yapıldı (aylık bordro ${fmt$(payroll())}). Personel memnun.`); }
  else if(a==='yarim'){ const ok=Math.random()<0.4+ik*0.35, h=Math.round(Z.pct/2); for(const p of staffNO()) p.salary=Math.round(p.salary*(1+h/100)/50)*50; morAll(ok?5:-6); popup(ok?'🤝':'😠','Karşı teklif',ok?`%${h} zam kabul edildi.`:`%${h} zam az bulundu ama kabul edilmek zorunda kalındı; moral düştü.`); }
  else { morAll(ik?-10:-18); const a2=avgMor(); if(a2<50&&Math.random()<(ik?0.35:0.7)){ S.strikeAt=S.day+2; S.strikePct=Z.pct; popup('⚠️','Grev uyarısı',`Zam reddedilince personel 2 gün sonra greve gideceğini söyledi. Ana sayfadan zam vererek önleyebilirsin.`); }
    else popup('😠','Zam reddedildi','Personel kırgın; moral düştü. Düşük moralde duygusal personel daha çok hata yapar, daha sık gelmez.'); }
  saveAll(); render(); }
function strikeEnd(){ const pct=(S.strike&&S.strike.pct)||S.strikePct||10; for(const p of staffNO()) p.salary=Math.round(p.salary*(1+pct/100)/50)*50; S.strike=null; S.strikeAt=null; S.lastRaise=S.day; morAll(10);
  for(const p of S.staff) if(p.role!=='owner') p.absent=false; popup('🤝','Grev bitti',`%${pct} zamla anlaşıldı, personel işe döndü.`); saveAll(); render(); }
let RZ={g:'all',k:10};
function raiseList(g){ const G=SGRP.find(x=>x[0]===g); return staffNO().filter(p=>!G||G[2].includes(p.role)); }
function raiseAllSheet(){ RZ={g:'all',k:10}; showSheet(()=>{ const L=raiseList(RZ.g), now=L.reduce((a,p)=>a+p.salary,0), nw=L.reduce((a,p)=>a+Math.round(p.salary*(1+RZ.k/100)/50)*50,0), mb=RZ.k>=20?18:RZ.k>=15?14:RZ.k>=10?10:5;
  const gs=[['all','Herkes',staffNO().length],...SGRP.map(([k,n,rs])=>[k,n,staffNO().filter(p=>rs.includes(p.role)).length]).filter(x=>x[2])];
  return `<div class="row"><b style="font-size:16px">💸 Toplu zam</b><button class="btn ghost" onclick="closeSheet()">Kapat</button></div>
   <div class="sub" style="margin:10px 2px 4px">Kime</div><div class="row" style="gap:6px;flex-wrap:wrap;justify-content:flex-start">${gs.map(([k,n,c])=>`<button class="btn ${RZ.g===k?'':'ghost'}" style="padding:6px 10px" onclick="RZ.g='${k}';refreshSheet()">${n} (${c})</button>`).join('')}</div>
   <div class="sub" style="margin:10px 2px 4px">Zam oranı</div><div class="row" style="gap:6px;flex-wrap:wrap;justify-content:flex-start">${[5,10,15,20,30].map(k=>`<button class="btn ${RZ.k===k?'':'ghost'}" style="padding:6px 12px" onclick="RZ.k=${k};refreshSheet()">%${k}</button>`).join('')}</div>
   <div class="card" style="margin-top:10px"><div class="grid2" style="margin:0;font-size:13px"><span class="sub">Kişi</span><span>${L.length}</span><span class="sub">Aylık maaş şimdi</span><span>${fmt$(now)}</span><span class="sub">Zamdan sonra</span><b>${fmt$(nw)} <span style="color:var(--bad)">(+${fmt$(nw-now)}/ay)</span></b><span class="sub">Moral</span><span style="color:var(--ok)">+${mb}</span></div>
   ${S.zam?`<div class="sub" style="margin-top:6px;color:#f5c542">Bekleyen zam talebi %${S.zam.pct}: ${RZ.g==='all'&&RZ.k>=S.zam.pct?'bu zam talebi karşılar.':'talebi karşılamak için herkese en az %'+S.zam.pct+' gerekir.'}</div>`:''}
   ${strikeOn()?`<div class="sub" style="margin-top:6px;color:#ff9b8a">Grev sürüyor: herkese en az %${S.strike.pct} zam grevi bitirir.</div>`:''}
   <div class="sub" style="margin-top:6px">Herkese aynı oranda zam kıskançlık yaratmaz. Sadece bir gruba zam verirsen diğerlerinin morali biraz düşer. Toplu zamdan sonra 6 ay zam talebi gelmez.</div></div>
   <button class="btn" style="width:100%;margin-top:10px" onclick="raiseAll()" ${L.length?'':'disabled'}>%${RZ.k} zam yap · +${fmt$(nw-now)}/ay</button>`; }); }
function raiseAll(){ const L=raiseList(RZ.g), k=RZ.k; if(!L.length) return; const mb=k>=20?18:k>=15?14:k>=10?10:5, all=RZ.g==='all';
  for(const p of L){ p.salary=Math.round(p.salary*(1+k/100)/50)*50; morAdd(p,mb); }
  if(!all){ const ik=ikQ(); for(const p of staffNO()) if(!L.includes(p)) morAdd(p,-(ik?1:3)*emoF(p)); }
  if(all){ S.lastRaise=S.day; if(S.zam&&k>=S.zam.pct){ S.zam=null; } if(strikeOn()&&k>=(S.strike.pct||10)){ S.strike=null; S.strikeAt=null; for(const p of S.staff) if(p.role!=='owner') p.absent=false; } else if(S.strikeAt&&k>=(S.strikePct||10)) S.strikeAt=null; }
  closeSheet(); toast(`💸 ${L.length} kişiye %${k} zam · aylık bordro ${fmt$(payroll())}`); saveAll(); render(); }
function giveRaise(pid,k){ const p=S.staff.find(x=>x.id===pid); if(!p) return; const pa=peerAvg(p); p.salary=Math.round(p.salary*(1+k/100)/50)*50; morAdd(p,k>=20?20:k>=10?12:6);
  if(pa&&p.salary>pa*1.25){ const L=staffNO().filter(x=>x.role===p.role&&x!==p), ik=ikQ(); for(const x of L) morAdd(x,-(ik?2:5)*emoF(x)); if(L.length) popup('😒','Kıskançlık',`${p.name}'e yapılan zam duyuldu: ${ROLES[p.role].name} arkadaşları “biz de aynı işi yapıyoruz” diye söylendi, morali düştü.${ik?' İK uzmanı durumu yumuşattı.':''}`); }
  toast(`${p.name}: maaş ${fmt$(p.salary)}/ay`); saveAll(); refreshSheet(); render(); }
// oyuna birkaç gün girilmezse atölyede tartışma çıkar
function awayFight(since){ if(!S||!S.shop||!since) return; const days=(Date.now()-since)/86400000; if(days<3) return; const L=staffNO(); if(L.length<2) return;
  const a=pick(L), b=pick(L.filter(x=>x!==a)), ik=ikMan();
  morAdd(a,(ik?-4:-12)*emoF(a)); morAdd(b,(ik?-4:-12)*emoF(b)); morAll(ik?-1:-3,a);
  POPQ.push({icon:'⚡',title:'Atölyede tartışma',msg:`Sen ${Math.floor(days)} gündür uğramadın. ${a.name} ve ${b.name} tartıştı. Konu: ${pick(['makine sırası','çay molasının uzaması','hurdayı kimin boşaltacağı','vardiya değişimi','bozuk parçanın kimin hatası olduğu','radyonun sesi'])}.${ik?` İK uzmanı ${ik.name} araya girdi, olay büyümeden çözüldü.`:' Ortam gergin, moraller düştü. Patron arada uğramalı.'}`}); showPop(); saveAll(); }
// yemek ısmarlama: sık ısmarlanırsa etkisi azalır
const FOODS=[['pasta','🎂','Doğum günü pastası',0,0],['lahmacun','🫓','Lahmacun + ayran',4,6],['pide','🥖','Kıymalı / kaşarlı pide',5,6],['doner','🌯','Döner dürüm',6,7],['etliekmek','🍕','Konya etliekmek',6,8],['kebap','🍢','Adana kebap',10,10],['iskender','🍛','İskender',12,11],['mangal','🔥','Bahçede mangal partisi',18,15]];
function cakeCost(){ return Math.round(30*(econ().price||1)); }
function foodCost(k){ const f=FOODS.find(x=>x[0]===k); return Math.round(f[3]*(staffNO().length+1)*(econ().price||1)); }
function treatF(){ const n=(S.treats||[]).filter(d=>d>S.day-30).length; return Math.max(0.25,1-n*0.25); }
function orderFood(k){ if(k==='pasta'){ const B=S.bdToday, p=B&&S.staff.find(x=>x.id===B.pid); if(!p||B.done){ toast('Bugün doğum günü yok'); return; } const c=cakeCost(); if(S.money<c){ toast('Para yetmiyor'); return; }
    cash(-c,'Doğum günü pastası',p.name); B.done=true; morAdd(p,12); morAll(2,p); popup('🎂','Pasta kesildi',`${p.name}'in doğum günü kutlandı. Çok sevindi, herkes bir dilim aldı.`); saveAll(); render(); return; }
  const f=FOODS.find(x=>x[0]===k), c=foodCost(k); if(!staffNO().length){ toast('Personel yok'); return; } if(S.money<c){ toast('Para yetmiyor'); return; }
  const e=Math.round(f[4]*treatF()*10)/10; cash(-c,'Personel yemeği',f[2]); (S.treats=S.treats||[]).push(S.day); S.treats=S.treats.filter(d=>d>S.day-60);
  for(const p of staffNO()) morAdd(p,e*(0.8+p.emo/40)); toast(`${f[1]} ${f[2]} ısmarlandı · moral +${e}${treatF()<1?' (sık ısmarlayınca etkisi azalıyor)':''}`); saveAll(); render(); }
function viewFood(){ const L=staffNO(), B=S.bdToday, bp=B&&!B.done&&S.staff.find(x=>x.id===B.pid);
  return `<div class="sub" style="margin:0 2px 8px">Personele yemek ısmarla: moral yükselir. Ortalama moral ${ikMan()?Math.round(avgMor()):morWord(avgMor())}. Bir ayda çok sık ısmarlarsan etkisi azalır (şu an %${Math.round(treatF()*100)}). Duygusal personel daha çok sevinir.</div>
   ${bp?`<div class="card" style="border-color:#b8902a"><div class="row"><span>🎂 Bugün <b>${bp.name}</b>'in doğum günü</span><button class="btn" onclick="orderFood('pasta')">Pasta ısmarla · ${fmt$(cakeCost())}</button></div></div>`:''}
   ${FOODS.filter(f=>f[0]!=='pasta').map(f=>`<div class="card"><div class="row"><div><b>${f[1]} ${f[2]}</b><div class="sub">${L.length+1} kişi · moral +${Math.round(f[4]*treatF()*10)/10}</div></div><button class="btn" onclick="orderFood('${f[0]}')" ${!L.length||S.money<foodCost(f[0])?'disabled':''}>${fmt$(foodCost(f[0]))}</button></div></div>`).join('')}`; }
function morWord(m){ return m>=75?'çok iyi':m>=60?'iyi':m>=45?'idare eder':m>=30?'düşük':'çok düşük'; }
function emoBar(p){ morOf(p); const e=p.emo; return `<div class="row" style="gap:8px;margin:4px 0"><span class="sub" style="width:92px">Duygusallık</span><div class="bar" style="flex:1;margin:0"><i style="width:${e*5}%;background:${e>=14?'var(--bad)':e>=8?'#f5c542':'var(--ok)'}"></i></div><b style="width:40px;text-align:right;font-size:12px">${e}/20</b></div><div class="sub" style="margin:2px 0 0">Duygusallık yeteneğe sayılmaz; yüksekse morali çabuk bozulur, düşük moralde daha çok hata yapar.</div>`; }
function morReasons(p){ morOf(p); const r=[], mk=salaryOf(p), pa=peerAvg(p);
  if(p.salary<mk*0.92) r.push(['−','maaşı piyasanın altında']); if(pa&&pa>p.salary*1.3) r.push(['−','aynı görevdekiler daha çok kazanıyor']);
  if(S.upgrades&&S.upgrades.night&&p.role==='op') r.push(['−','gece vardiyası']); if(CFG.tea===false) r.push(['−','çay molası yok']); if(strikeOn()) r.push(['−','grev']);
  if(decorF()<1) r.push(['+','bahçe düzenlemesi']); if((S.treats||[]).some(d=>d>S.day-30)) r.push(['+','yakında yemek ısmarlandı']); if(ikMan()) r.push(['+','İK uzmanı ilgileniyor']);
  return r; }
function moraleCard(){ const L=staffNO(); if(!L.length) return ''; const ik=ikMan(), low=L.filter(p=>morOf(p)<45);
  return `<div class="card"><div class="row"><b>Personel morali</b><span>${morBars(avgMor())} <span class="sub">ortalama ${Math.round(avgMor())}</span></span></div>
   <div class="sub" style="margin-top:6px">${low.length?`Morali düşük: ${low.map(p=>`${p.name.split(' ')[0]} (${Math.round(p.mor)}${p.emo>=14?', duygusal':''}${morReasons(p).filter(x=>x[0]==='−').map(x=>', '+x[1]).join('')})`).join(' · ')}.`:'Şu an morali düşük kimse yok.'}
   ${ik?` İK uzmanı ${ik.name.split(' ')[0]} takipte: eksik tesviye, paketleme ve güvenlik elemanını alır, doğum günlerini kutlar, tartışmaları çözer, zam pazarlığında yardım eder, morali biraz yukarıda tutar.`:' İK uzmanı alırsan eksik tesviye, paketleme ve güvenlik elemanını kendisi alır, doğum günlerini kendisi kutlar, tartışmaları çözer, zam pazarlığında yardım eder (Mağaza › 👷 Personel).'}
   Düşük moralde personel daha çok hata yapar ve gelmez. Duygusallığı yüksek olanın morali daha çabuk bozulur. Moral: piyasanın altında maaş, kıskançlık, gece vardiyası, çay molasız çalışma ve reddedilen zamla düşer; yemek, doğum günü, zam ve bahçe düzenlemesiyle yükselir.</div>
   <div class="row" style="margin-top:8px;justify-content:flex-start;gap:6px"><button class="btn ghost" onclick="storeTab='yemek';go('store')">🍽️ Yemek ısmarla</button></div></div>`; }

