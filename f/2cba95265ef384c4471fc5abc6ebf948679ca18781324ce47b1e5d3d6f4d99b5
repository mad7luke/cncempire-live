function calPrice(k){ return k==='cmm'?S.equip.filter(e=>(e.type==='cmm'||isGcmm(e.type))&&e.placed).reduce((a,e)=>a+(isGcmm(e.type)?Math.round((CFG.prices[e.type]||650000)*0.03/100)*100:cmmCal(e.cmmModel||'mit_c')),0):gCal(k); }
