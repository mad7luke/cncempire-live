  const buf=new Uint8Array(await new Response(new Blob([js]).stream().pipeThrough(new CompressionStream('gzip'))).arrayBuffer()); let bin=''; for(let i=0;i<buf.length;i+=0x8000) bin+=String.fromCharCode.apply(null,buf.subarray(i,i+0x8000)); return 'G'+btoa(bin); }
async function unpackState(d){ if(d[0]==='J') return JSON.parse(d.slice(1)); const bin=atob(d.slice(1)), u=new Uint8Array(bin.length); for(let i=0;i<bin.length;i++) u[i]=bin.charCodeAt(i);
  return JSON.parse(await new Response(new Blob([u]).stream().pipeThrough(new DecompressionStream('gzip'))).text()); }
function slotSaved(){ return !!(S.slotId&&S.slotT===S.t&&slotList().some(x=>x.id===S.slotId)); }
function agoTxt(t){ const m=Math.round((Date.now()-t)/60000); return m<1?'az önce':m<60?`${m} dk önce`:m<1440?`${Math.round(m/60)} saat önce`:new Date(t).toLocaleDateString(NLOC); }
async function saveSlot(id,name){ const L=slotList(); if(!id&&L.length>=SLOT_MAX){ toast(`En fazla ${SLOT_MAX} kayıt: önce birini sil ya da üstüne kaydet`); return false; }
  id=id||('s'+Date.now().toString(36)); const old=L.find(x=>x.id===id), nm=(name||(old&&old.name)||`${firmName()} · Gün ${S.day}`).trim().slice(0,40);
  S.slotId=id; S.slotT=S.t; S.lastSeen=Date.now(); let d; try{ d=await packState(unionDo(()=>JSON.parse(JSON.stringify(S)))); localStorage.setItem('ta5_slot_'+id,d); }catch(e){ toast('Kayıt yeri doldu: eski bir kaydı sil'); return false; }
  const meta={id,name:nm,firm:firmName(),mode:S.mode||'zor',day:S.day,money:Math.round(S.money),mach:S.machines.length,staff:S.staff.length,t:Date.now(),kb:Math.max(1,Math.round(d.length/1024))};
  const i=L.findIndex(x=>x.id===id); if(i>=0) L.splice(i,1); L.unshift(meta); slotIdx(L); saveAll(); toast(`💾 Kaydedildi: ${nm}`); return true; }
async function loadSlot(id){ const d=localStorage.getItem('ta5_slot_'+id); if(!d){ toast('Kayıt bulunamadı'); return; } let o; try{ o=await unpackState(d); }catch(e){ toast('Kayıt açılamadı'); return; }
  o.lastSeen=Date.now(); o.slotId=id; o.slotT=o.t; if(o.mode&&GMODES[o.mode]) applyMode(o.mode);
  NOSAVE=true; try{ localStorage.setItem('ta5_cfg',JSON.stringify(CFG)); localStorage.setItem('ta5_state',JSON.stringify(o)); }catch(e){ NOSAVE=false; toast('Kayıt açılamadı (yer yok)'); return; }
  location.reload(); }
function delSlot(id){ localStorage.removeItem('ta5_slot_'+id); slotIdx(slotList().filter(x=>x.id!==id)); if(S.slotId===id){ S.slotId=null; } toast('Kayıt silindi'); refreshSheet(); }
