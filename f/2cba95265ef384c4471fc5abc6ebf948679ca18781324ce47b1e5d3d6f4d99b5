  const opS=pm.filter(m=>!staffed(m)).length; if(opS) add(3,`${opS} makine operatör olmadığı için duruyor. ${Math.ceil(opS/opMax())>1?Math.ceil(opS/opMax())+' operatör':'1 operatör'} al.`,go_('Operatör al',"storeTab='staff';go('store')"));
