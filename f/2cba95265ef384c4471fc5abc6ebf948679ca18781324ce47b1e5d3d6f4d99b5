function needOk(t){ if(CERTS[t]) return hasCert(t); if(t==='guv') return !!(S.upgrades&&S.upgrades.security); if(t==='qc') return S.staff.some(p=>p.role==='qc'); if(t==='cmm'||t==='koda') return has(t);
  if(t==='m5') return S.machines.some(m=>m.placed&&['mill5','millturn'].includes(MODELS[m.model].cat));
  if(t==='agir') return S.machines.some(m=>m.placed&&MODELS[m.model].heavy); if(t==='kpiq'){ const q=kpi().q; return q!=null&&q>=85; } return true; }
function needLbl(t){ return CERTS[t]?CERTS[t].n:NEEDL[t]||t; }
function certPrice(k){ return (CFG.certP&&CFG.certP[k])??CERTS[k].cost; }
// denetim: kontrol listesi (her madde şansa katkı yapar)
function auditList(k){ const K=kpi(), n=(S.kpi&&S.kpi.jobs||[]).length, q=K.q, t=K.t, qc=Math.max(0,...S.staff.filter(p=>p.role==='qc').map(p=>p.s.dik)), gk=Object.keys(GAUGES).filter(k=>GAUGES[k].core), gh=gk.filter(g=>hasG(g)).length;
  const defn=k==='aqap', aero=k==='as9100';
  return [
   ['Kayıtlı iş geçmişi (son 30 gün)', n>=30?0.15:n>=10?0.08:0, `${n} iş${n<10?' · en az 10 iş kaydı gerekir':''}`, 0.15],
   ['Kalite puanı', q==null?-0.05:q>=95?0.15:q>=90?0.10:q>=80?0.04:q>=70?-0.05:-0.15, q==null?'kayıt yok':'%'+q, 0.15],
   ['Termin puanı', t==null?0:t>=90?0.05:t>=80?0.02:-0.05, t==null?'kayıt yok':'%'+t, 0.05],
   ['Kalitecinin dikkati', qc/20*0.10, qc?qc+'/20':'kaliteci yok', 0.10],
   ['Kalibreli ölçü aletleri', gh/gk.length*0.10, `${gh}/${gk.length}`, 0.10],
   ['Kalite masası / granit masa', (has('kmasa')||has('olcum'))?0.03:0, '', 0.03],
   ['Kalite odası (klimalı)', has('koda')?(aero?0.12:0.08):0, '', aero?0.12:0.08],
   ['CMM ölçüm raporu', has('cmm')?(aero||defn?0.08:0.04):0, '', aero||defn?0.08:0.04],
   ['Kamera ve güvenlik sistemi', S.upgrades&&S.upgrades.security?(defn?0.12:0.04):0, defn?'savunmada önemli':'', defn?0.12:0.04],
   ['Güvenlik kulübesi ve bekçi', (S.yard&&S.yard.booth?0.01:0)+(S.staff.some(p=>p.role==='guard')?(defn?0.04:0.02):0), 'giriş-çıkış kaydı', defn?0.05:0.03],
   ['Mutfak / sosyal alan', has('mutfak')?0.03:0, 'çalışma koşulları', 0.03],
   ['Tesviye ve paketleme odası', hasToda()?0.02:0, 'çapaksız, hasarsız sevk', 0.02],
   ['Takım ön ayar ve takım dolabı', (has('onayar')?0.02:0)+(has('dolap')?0.01:0), 'izlenebilirlik', 0.03]]; }
function auditP(k){ k=k||'iso9001'; const base=k==='iso9001'?0.12:k==='aqap'?0.06:0.02; return clamp(base+auditList(k).reduce((a,x)=>a+x[1],0),0.05,0.95); }
function applyCert(k){ const C=CERTS[k], c=certS()[k]; if(calLate().length){ toast('Önce süresi geçen ölçü aletlerini kalibre ettir'); return; } const re=c&&(c.st==='askida'||c.st==='kaldi'); const cost=Math.round(certPrice(k)*(re?0.3:1));
  if(!C.need.every(needOk)){ toast('Şartlar tamam değil'); return; } if(S.money<cost){ toast('Para yetmiyor'); return; }
  cash(-cost,re?'Belge yeniden denetim':'Belge danışmanlık + denetim',C.n); certS()[k]={st:'hazirlik',day:S.day+(re?20:C.days),p0:auditP(k)}; toast(`${C.n} süreci başladı · denetim ${re?20:C.days} gün sonra`); saveAll(); render(); }
function certDay(){ for(const [k,c] of Object.entries(certS())){ const C=CERTS[k]; if(!C) continue;
  if(c.st==='hazirlik'&&S.day>=c.day){ const pN=auditP(k), p0=c.p0??pN, p=clamp((p0+pN)/2,0.05,0.95), roll=Math.random(), pct=v=>'%'+Math.round(v*100);
    const why=`Başvuruda şansın ${pct(p0)}, denetim günü ${pct(pN)}; denetimde ikisinin ortalaması ${pct(p)} sayıldı.`;
    const weak=auditList(k).filter(x=>x[1]<x[3]-1e-6).sort((a,b)=>(b[3]-b[1])-(a[3]-a[1])).slice(0,3).map(x=>`${x[0]}${x[2]?` (${x[2]})`:''}`);
    if(roll<p){ c.st='var'; c.next=S.day+365; tanAdd(5); popup('📜',`${C.n} belgesi alındı`,`Denetim başarılı. ${why} Belge 3 yıl geçerli, her yıl ${fmt$(C.yearly)} gözetim denetimi var.${k==='iso9001'?' Büyük firmalara tedarikçi başvurusu yapabilirsin (ParçaAğı › Firmalar).':''}`); }
    else { c.st='kaldi'; c.p0=null; popup('📋',`${C.n} denetiminde uygunsuzluk`,`${why} ${p>=0.85?'Şansın yüksekti ama denetçi bir uygunsuzluk yakaladı (her denetimde küçük bir risk kalır).':'Denetçi kayıtlarda eksik buldu.'}${weak.length?` En çok puan kaybettiğin yerler: ${weak.join(', ')}.`:''} Yeniden denetim %30 ücretle, 20 gün sonra.`); } }
  else if(c.st==='var'&&S.day>=c.next){ cash(-C.yearly,'Belge gözetim denetimi',C.n); const q=kpi().q; if(q!=null&&q<70){ c.st='askida'; popup('⚠️',`${C.n} askıya alındı`,`Gözetim denetiminde kalite puanın %${q}. Belge askıda; bu belgeyi isteyen firmalar yeni iş göndermez. %30 ücretle yeniden denetim iste.`); } else c.next=S.day+365; } } }
function firmReqOk(k){ return BIGF[k].req.every(needOk); }
function firmScore(k,d,why){ const f=firmS()[k]; if(!f||f.st!=='onay') return; f.score=clamp((f.score??70)+d,0,100); f.hist=[...(f.hist||[]),{d:S.day,v:d,w:why||(d>0?'zamanında teslim':''),s:Math.round(f.score)}].slice(-40); { const w=why||(d>0?'zamanında teslim':''); f.cnt=f.cnt||{}; const c=f.cnt[w]||(f.cnt[w]=[0,0]); c[0]++; c[1]+=d; }
  if(f.score<40){ f.suspN=(f.suspN||0)+1; const d=suspDays(f.suspN); f.st='askida'; f.why='puan'; f.reWait=false; f.day=S.day+d;
    popup('⛔',`${BIGF[k].n} tedarikçiliği askıya aldı`,`Tedarikçi puanın ${Math.round(f.score)}'e düştü${why?` (son olay: ${why})`:''}. Bu ${f.suspN}. askı: ${suspTxt(d)}. Tekrar incelemeye gelme günü: Gün ${f.day}. ${f.suspN<3?`Bir sonraki askı ${suspTxt(suspDays(f.suspN+1))} olur.`:''}`); } }
// askı süresi: 1. kez 60 gün, 2. kez 120 gün, 3. kez ve sonrası 1 yıl
function suspDays(n){ return n<=1?60:n===2?120:365; }
function suspTxt(d){ return d>=365?'1 yıl':d+' gün'; }
function applyFirm(k){ const F=BIGF[k], fee=firmFee(k); if(!firmReqOk(k)){ toast('Şartlar tamam değil'); return; } if(S.money<fee){ toast('Para yetmiyor'); return; }
  cash(-fee,'Tedarikçi denetimi (dosya + ziyaret)',F.n); firmS()[k]={st:'basvuru',day:S.day+25,suspN:(firmS()[k]||{}).suspN||0}; toast(`${F.n} başvurun alındı · tedarikçi denetimi 25 gün sonra`); saveAll(); render(); }
function firmDay(){ for(const [k,f] of Object.entries(firmS())){ const F=BIGF[k]; if(!F) continue;
  if(f.st==='basvuru'&&S.day>=f.day){ const p=clamp((auditP(F.sec==='Havacılık'||F.sec==='Uzay'?'as9100':F.sec==='Savunma'?'aqap':'iso9001')+(S.rep-60)/200)*(F.abroad?0.85:1),0.05,0.95);
    if(firmReqOk(k)&&Math.random()<p){ f.st='onay'; f.score=f.re?55:70; tanAdd(4); f.re=false; f.next=S.day+1; popup('🤝',`${F.n} onaylı tedarikçisi oldun`,`Artık ${F.n} sana doğrudan teklif isteği gönderecek (ParçaAğı › Firmalar). Ödeme ${F.pay} gün vadeli. Zamanında ve hatasız teslim ettikçe daha çok iş gelir; geç teslim ve kalite hatası puanını düşürür.`); }
    else { f.st='red'; f.re=false; f.day=S.day+45; popup('📁',`${F.n} başvurusu olumsuz`,`Tedarikçi denetiminde kalite ve termin performansın yeterli bulunmadı. 45 gün sonra tekrar başvurabilirsin.`); } }
  else if(f.st==='askida'&&f.why!=='sart'&&S.day>=f.day&&!f.reWait){
    if(firmReqOk(k)){ f.st='basvuru'; f.day=S.day+3; f.re=true; popup('🔎',`${F.n} tekrar incelemeye geliyor`,`${f.suspN||1}. askı süresi doldu. ${F.n} 3 gün içinde tedarikçi denetimine gelecek (ücreti firma karşılar). Geçersen yeniden onaylı tedarikçi olursun; puanın 55'ten başlar.`); }
    else { f.reWait=true; popup('🔎',`${F.n} askı süresi doldu`,`Ama şartlardan biri eksik: ${F.req.filter(t=>!needOk(t)).map(needLbl).join(', ')}. Eksiği tamamlayınca tedarikçi başvurusu yap.`); } }
  else if(f.st==='onay'){ if(!firmReqOk(k)){ f.st='askida'; f.why='sart'; f.day=S.day; f.miss=F.req.filter(t=>!needOk(t)); popup('⛔',`${F.n} yeni iş göndermiyor`,`Şartlardan biri kayboldu: ${F.req.filter(t=>!needOk(t)).map(needLbl).join(', ')}. Eksiği tamamlayınca yeniden başvur.`); continue; }
    if(S.day>=(f.next??0)){ const open=S.offers.filter(o=>o.firm===k).length; if(open<3){ const n=Math.random()<0.35?2:1; for(let i=0;i<n;i++) S.offers.push(makeOffer({firm:k})); toast(`🏭 ${F.n}'dan teklif isteği geldi`); }
      f.next=S.day+Math.max(2,Math.round((9-(f.score??70)/14+Math.random()*3)*(crisisOn()?1.7:1))); } } } }
