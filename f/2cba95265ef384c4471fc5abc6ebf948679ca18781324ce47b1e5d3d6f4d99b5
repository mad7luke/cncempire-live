function rivalsDay(){ const R=rbS(), D=rbD(), econP=((S.econ&&S.econ.price)||1)/ctry().p, crisisF=crisisOn()?CRISIS.demand:1;
  if(S.day-(S.rbAnonD||0)>=30){ S.rbAnonD=S.day; if(Math.random()<0.35) S.rbAnon=(S.rbAnon||0)+1; }
