// büyük program: savunma / havacılık firmasıyla 24-36 ay süren seri üretim. Her ay büyük bir lot (1,5-3 makinelik iş).
// Şart: firmanın belgeleri + onaylı tedarikçilik + makine sayısı (+ havacılıkta 5 eksen). Başlarken aparat/özel takım/PPAP yatırımı ve teminat.
const PROG_NAMES={Savunma:['zırhlı araç süspansiyon','füze gövde flanşı','radar soğutucu kutusu','namlu bağlantı parçası','atış kontrol kapağı'],Havacılık:['kanat bağlantı braketi','motor yatağı burcu','iniş takımı mili','kabin kapı menteşesi','türbin disk tutucusu'],Uzay:['uydu yapısal braketi','yakıt hattı bağlantısı','anten yuvası']};
function progS(){ if(!S.progs) S.progs={next:S.day+ri(60,150),offer:null}; return S.progs; }
function progFirms(){ return Object.keys(BIGF).filter(k=>['Savunma','Havacılık','Uzay'].includes(BIGF[k].sec)); }
function makeProgram(k){ const F=BIGF[k], base=makeOffer({firm:k}); if(!base) return null;
  const months=pick([24,30,36]), hpp=Math.max(0.05,(base.cam+base.bag*1.5)/60), allC=myMach()*machMonthH(), catC=S.machines.filter(m=>m.placed&&canDo(m,base)[0]).length*machMonthH(), tgtH=Math.max(ri(260,520),Math.min(allC*r2(0.15,0.30),Math.max(catC,machMonthH()*2)*0.7)), qty=Math.max(20,Math.round(tgtH/hpp/10)*10);
  const sp={...base, qty}, rh=progHours(sp)+ayarRef(sp)+qty*(sp.cam+sp.bag*1.5)/60;
  const lotPrice=Math.round((rh*(rateFor(sp)*difficulty(sp)*TOL[tolIdx(sp)].p*F.mult*0.92+(opHourAdd()+flatH(needs(sp)))*(tolIdx(sp)>=2?1+(TOL[tolIdx(sp)].p-1)*0.85:1)) + toolUse(sp,rh) + baseMaterial(sp)*1.15 + (sp.fason?fasonCost(sp)*1.25:0))/50)*50, tot=lotPrice*months;
  const nm=pick(PROG_NAMES[F.sec]||PROG_NAMES.Savunma);
  return {firm:k, spec:{...base, qty, contract:null, tender:false}, months, lotQty:qty, lotPrice, startup:Math.round(tot*0.05/100)*100, bond:Math.round(tot*0.04/100)*100,
    minM:F.sec==='Savunma'?8:10, m5:F.sec==='Savunma'?0:2, name:nm, expires:S.day+60}; }
function progReqs(P){ const F=BIGF[P.firm], f=firmS()[P.firm], n5=S.machines.filter(m=>m.placed&&MODELS[m.model].cat==='mill5').length;
  const r=F.req.map(t=>[needLbl(t),needOk(t)]); r.push([`${F.n} onaylı tedarikçisi`,!!f&&f.st==='onay'],[`En az ${P.minM} makine (şu an ${myMach()})`,myMach()>=P.minM]);
  if(P.m5) r.push([`En az ${P.m5} adet 5 eksen (şu an ${n5})`,n5>=P.m5]);
  { const nd=needs(P.spec), lbl=TCATN[nd]||CATN[nd]||nd, ok=S.machines.filter(m=>m.placed&&canDo(m,P.spec)[0]), same=S.machines.filter(m=>m.placed&&needCat(MODELS[m.model].cat)===nd);
    r.push([`Parçaya uygun tezgâh: ${lbl}${ok.length?` (sende: ${[...new Set(ok.map(m=>MODELS[m.model].name))].slice(0,2).join(', ')})`:same.length?` (${canDo(same[0],P.spec)[1]||'seninkiler yetmiyor'})`:' (sende yok)'}`,ok.length>0]); } return r; }
function progOk(P){ return progReqs(P).every(x=>x[1]); }
function progDay(){ const G=progS(); if(G.offer&&S.day>G.offer.expires){ G.offer=null; }
  if(S.day<G.next||!S.shop) return; G.next=S.day+ri(120,220);
  if(G.offer||(S.contracts||[]).some(c=>c.prog&&c.st==='aktif')||myMach()<4||tanS()<35) return;
  const mine=progFirms().filter(k=>firmS()[k]&&firmS()[k].st==='onay'), k=mine.length&&Math.random()<0.7?pick(mine):pick(progFirms());
  const P=makeProgram(k); if(!P) return; G.offer=P;
