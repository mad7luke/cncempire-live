  for(const r of ['tesviye','paket']){ const n=S.staff.filter(p=>p.role===r).length, need=postNeedN(r); if(n<need) add(present('ik').length&&CFG.ikHire!==false?1:2,`${ROLES[r].name}: ${n}/${need}.${present('ik').length&&CFG.ikHire!==false?' İK uzmanı alacak.':' İK uzmanı alırsan kendisi alır.'}`,go_('Personel',"storeTab='staff';go('store')")); }
  for(const g of ['kap','isil']){ const u=facNeedUp(g); if(u) add(u.pend?2:1,`${facName(g)} küçük kalıyor: ${u.pend+u.past} büyük iş fasona gidiyor. Öneri: ${FACX[u.k].n}.`,go_('Tesisler',"storeTab='fac';go('store')")); }
  if(S.money<0) add(3,`Kasa eksi (${fmt$(S.money)}): KMH faizi işliyor, tedarikçi borcu ödenemezse mal vermez.`,go_('Finans',"go('fin')"));
  const holds=Object.entries(S.hold||{}).filter(([kk,v])=>v); if(holds.length) add(3,`${holds.map(([kk])=>supName(kk)).join(', ')} borç yüzünden mal/hizmet vermiyor.`,go_('Finans',"go('fin')"));
  if((S.toolStock??1)<=dailyToolUse()*2) add(3,'Kesici takım stoğu 2 günden az kaldı.',go_('Takım al',"storeTab='tools';go('store')"));
  const cl=calLate(); if(cl.length) add(3,`${cl.length} ölçü aleti/cihazın kalibrasyonu geçti, kullanılamıyor.`,go_('Kalibre et',"storeTab='gauge';go('store')"));
  const gm=new Set(); for(const o of S.orders.filter(o=>o.st!=='tamam')) for(const g of gaugeMiss(o)) gm.add(g); if(gm.size) add(2,`Açık siparişlerin istediği ama olmayan aletler: ${[...gm].slice(0,4).map(g=>GAUGES[g].sn).join(', ')}${gm.size>4?' vb.':'.'}`,go_('Ölçü aletleri',"storeTab='gauge';go('store')"));
  const ovh=pm.filter(m=>m.ovhDue||m.bsDue); if(ovh.length) add(2,`${ovh.length} makinenin revizyonu gecikti (${MODELS[ovh[0].model].name}${ovh.length>1?'…':''}); arıza ve kalite hatası artar.`,go_('Atölye',"go('shop')"));
  if(pm.some(m=>!airOk(m))) add(3,'Basınçlı hava yetmiyor, bazı makineler duruyor.',go_('Kompresör',"storeTab='pow';go('store')"));
  if(!S.staff.some(p=>p.role==='plan')&&pm.length>=3) add(2,'Planlama mühendisi yok: işleri makinelere dengeli dağıtan, terminine yetişmeyecek işi almayan biri lazım.',go_('Personel',"storeTab='staff';go('store')"));
