function startBuy(kind,key,opt={}){
  if(!S.shop){ toast('Önce bir dükkan kirala'); go('estate'); return; }
  let cm=null; if(key.startsWith('cmm_')){ cm=key.slice(4); key='cmm'; }
  let price=cm?cmmPrice(cm):CFG.prices[key], used=null, pay=opt.pay||'cash', term=opt.term||0;
  if(opt.uid){ used=S.used.find(u=>u.uid===opt.uid); if(!used) return; price=used.price; }
  const lc= pay==='lease'?leaseCalc(cm?'cmm_'+cm:key,term):null; const now= lc?lc.down:price;
  if(S.money<now){ toast('Para yetmiyor'); return; }
  if(EQUIP[key]&&EQUIP[key].gen){ const e0={type:key}; if(!autoPlace(e0)){ toast('Bahçede jeneratör yeri yok (en fazla 2; büyük jeneratör için bahçede boş alan gerekir)'); return; } const pr=CFG.prices[key]; if(S.money<pr){ toast('Para yetmiyor'); return; }
    cash(-pr,'Ekipman alımı',EQUIP[key].name); const e=newEquip(key); autoPlace(e); S.equip.push(e); closeSheet(); toast(`🔌 ${EQUIP[key].name} bahçeye kuruldu · istersen Taşı ile yerini değiştir`); saveAll(); render(); return; }
  if(EQUIP[key]&&EQUIP[key].air){ const e0={type:key}; if(!autoPlace(e0)){ toast('Bahçede kompresör için boş yer yok: bahçede yer aç ya da büyük bahçeli dükkâna geç'); return; } const pr=CFG.prices[key]; if(S.money<pr){ toast('Para yetmiyor'); return; }
    cash(-pr,'Ekipman alımı',EQUIP[key].name); const e=newEquip(key); autoPlace(e); e.svc=S.day; S.equip.push(e); closeSheet(); toast(`💨 ${EQUIP[key].name} bahçeye kuruldu, hava hattı atölyeye çekildi · istersen Taşı ile yerini değiştir`); saveAll(); render(); return; }
  if(key==='cmm'&&!freeRoom()){ popup('🧪','Kalite odası gerekli',S.equip.some(e=>isKoda(e.type)&&e.placed)?'Kalite odandaki yer dolu. Kalite odasına 1, büyük kalite odasına 2 CMM sığar; yeni CMM için bir oda daha yaptır ya da odayı büyüt (Mağaza › Kalite).':'CMM yalnızca klimalı kalite odasına kurulur. Önce Mağaza › Kalite’den kalite odası yaptır.'); return; }
  const obj = kind==='m'?{id:'tmp',model:key,rot:0}:{id:'tmp',type:key,rot:0,...(cm?{cmmModel:cm}:{})};
  const probe={...obj}; if(!autoPlace(probe)){ toast('Dükkanda uygun yer yok (alan veya elektrik)'); return; } if(probe.room) obj.room=probe.room;
  closeSheet(); placing={obj, isNew:true, price:now, x:probe.x, y:probe.y, rot:probe.rot, kind, pay, term, lc, used};
  const sp=spotFresh(); SPOT=null;
  if(sp&&!!sp.yard===!!isYardEq(obj)&&obj.type!=='cmm'){ let ok=false;
    for(const r of [probe.rot||0,(probe.rot||0)?0:1]){ const [w,d]=dims({...obj,rot:r}), B=placeBounds(obj,r), x=snapTo(sp.x-w/2,B.x0,B.x1,B.snap), y=snapTo(sp.y-d/2,B.y0,B.y1,B.snap);
      if(!placeCheck(obj,x,y,r)){ Object.assign(placing,{x,y,rot:r}); ok=true; break; } }
    if(!ok){ const [w,d]=dims({...obj,rot:placing.rot}), B=placeBounds(obj,placing.rot); placing.x=snapTo(sp.x-w/2,B.x0,B.x1,B.snap); placing.y=snapTo(sp.y-d/2,B.y0,B.y1,B.snap); toast('Seçtiğin yer dar ya da dolu: sürükleyip uygun yere koy'); }
    else if(opt.auto){ editMode=true; tab='shop'; placeConfirm(); return; } }
  else if(sp&&sp.yard&&!isYardEq(obj)) toast('Makine ve atölye ekipmanı bahçeye konmaz; atölyede uygun yere yerleştirildi');
  go('shop');
}
