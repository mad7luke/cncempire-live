function postWorkers(r){ const L=present(r), own=S.staff.find(p=>p.role==='owner'&&!p.absent), pk=present('paket').length>0, oc=own?(r==='tesviye'?(pk?0.5:0.35):(pk?0.25:0.75)):0;
  if(L.length) return {pro:true,cap:oc+L.reduce((a,p)=>a+(0.75+p.s.tec/40)*(r==='tesviye'&&has('capak')?1.25:1)*(hasToda()?1.15:1),0),dik:L.reduce((a,p)=>a+p.s.dik,0)/L.length};
  const alt=present(r==='tesviye'?'paket':'tesviye'); if(alt.length) return {pro:true,cap:oc+alt.length*0.4,dik:alt.reduce((a,p)=>a+p.s.dik,0)/alt.length};
  return {pro:false,cap:own?(r==='tesviye'?1.0:0.75):0,dik:own?own.s.dik:10}; }
function postBacklogDays(st){ return tmemo('pbd'+st,()=>postBacklogDays0(st)); }
function postBacklogDays0(st){ const W=postWorkers(st), m=postQueue(st).reduce((a,o)=>a+o.postLeft,0); return W.cap>0?m/(W.cap*workHours()*60):9; }
function postStage(o,st){ const full=postFull(o,st), pre=st==='tesviye'?(o.tvPre||0):(o.pkPre||0); o.st=st; o.postNeed=Math.max(st==='tesviye'?8:6,full); o.postLeft=Math.max(st==='tesviye'?4:6,Math.round(full-pre)); }
// parçalar tezgahtan çıktıkça tesviye ve (fason/CMM yoksa) paketleme işleme sürerken yapılır; boşta kalan eleman öne çalışır
function postPre(st,cap){ for(const m of S.machines){ if(cap<=0) break; const c=m.cur; if(!c||c.fai) continue; const o=ordGet(c.oid); if(!o) continue; const mm=Math.max(0,c.done-(c.setup||0));
    const q=Math.max(1,o.qty||1), cyc=Math.max(0.2,(c.need-(c.setup||0))/q), tvF=tvPer(cyc)/cyc;
    if(st==='tesviye'){ const a=mm*tvF-(c.tv||0); if(a<=0) continue; const u=Math.min(cap,a); c.tv=(c.tv||0)+u; cap-=u; }
    else { if(o.fason||o.cmm100) continue; const a=(c.tv||0)/tvPer(cyc)*pkPer(o)-(c.pk||0); if(a<=0) continue; const u=Math.min(cap,a); c.pk=(c.pk||0)+u; cap-=u; } }
  return cap; }
