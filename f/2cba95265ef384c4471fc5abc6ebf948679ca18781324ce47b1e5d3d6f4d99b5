let ASK=null;
const askOn=act=>!!(ASK&&ASK.act===act&&Date.now()-ASK.t<5000);
function ask(el,act){ if(askOn(act)){ ASK=null; doAsk(act); return; } ASK={act,t:Date.now()}; refreshSheet(); setTimeout(()=>{ if(ASK&&ASK.act===act&&!askOn(act)){ ASK=null; refreshSheet(); } },5100); }
function askBtn(act,label,msg,primary){ const on=askOn(act); return `<button class="btn${on||primary?'':' ghost'}" ${on?'style="background:var(--bad);border-color:var(--bad);color:#fff"':''} onclick="ask(this,'${act}')">${on?msg:label}</button>`; }
function doAsk(act){ const [k,id]=act.split(':'); if(k==='load') loadSlot(id); else if(k==='del') delSlot(id); else if(k==='over') saveSlot(id).then(ok=>ok&&closeSheet()); }
