  const up=e=>{ pts.delete(e.pointerId); if(!VW) return; if(pts.size===1){ const [a]=[...pts.values()]; g={x:a.x,y:a.y,f:VW.f,tx:VW.tx,ty:VW.ty}; } else if(!pts.size) g=null; };
