// kendi tesise sığmayan işler: sayılır, büyütme önerilir
function facOf(t){ return Object.values(facS()).find(f=>FAC[f.k]&&FAC[f.k].types&&FAC[f.k].types.test(t))||null; }
function facNeedUp(g){ const f=facS()[g]; if(!f||!FAC[f.k].types) return null; const F=FAC[f.k], mx=facMaxLen(f);
  const pend=[...S.orders.filter(o=>o.st!=='tamam'), ...(S.offers||[])].filter(o=>o.fason&&o.big&&F.types.test(o.fason.t)&&bigDim(o)>mx);
  const past=((S.facMiss||{})[g]||[]).filter(x=>x.d>S.day-120);
  if(!pend.length&&!past.length) return null;
  const need=Math.max(...pend.map(bigDim),...past.map(x=>x.len)), own=k=>f.up&&f.up[k];
  const ups=Object.entries(FACX).filter(([k,X])=>X.g===g&&X.len).sort((a,b)=>a[1].len-b[1].len);
  const tgt=(ups.find(([k,X])=>X.len>=need)||ups[ups.length-1]||[])[0]; if(!tgt||own(tgt)) return null;
  let k=tgt; while(FACX[k].need&&!own(FACX[k].need)) k=FACX[k].need;
  return {k, tgt, need, mx, pend:pend.length, past:past.length, lost:Math.round(past.reduce((a,x)=>a+(x.c||0),0)), fits:FACX[tgt].len>=need};
}
