// ===================== İZOMETRİK ÇİZİM =====================
const IA=16, IB=8, IC=19.6;   // 1 m: yatay 16, dikey 8, yükseklik 17 px
const P0=(x,y,z)=>[(x-y)*IA,(x+y)*IB-z*IC];
let VK=0, VCX=0, VCY=0;    // görünüm dönüşü (90° adım) ve dönme merkezi
function rotV(x,y){ let dx=x-VCX, dy=y-VCY; for(let i=0;i<VK;i++){ const t=dx; dx=dy; dy=-t; } return [dx+VCX,dy+VCY]; }
function unrotV(x,y){ let dx=x-VCX, dy=y-VCY; for(let i=0;i<VK;i++){ const t=dx; dx=-dy; dy=t; } return [dx+VCX,dy+VCY]; }
function dirV(nx,ny){ for(let i=0;i<VK;i++){ const t=nx; nx=ny; ny=-t; } return [nx,ny]; }
function undirV(nx,ny){ for(let i=0;i<VK;i++){ const t=nx; nx=-ny; ny=t; } return [nx,ny]; }
const P=(x,y,z)=>{ if(!VK) return P0(x,y,z); const r=rotV(x,y); return P0(r[0],r[1],z); };
function rectV(x,y,w,d){ if(!VK) return {x,y,w,d}; const a=rotV(x,y), b=rotV(x+w,y+d); return {x:Math.min(a[0],b[0]),y:Math.min(a[1],b[1]),w:Math.abs(a[0]-b[0]),d:Math.abs(a[1]-b[1])}; }
function isBack(nx,ny){ const [a,b]=dirV(nx,ny); return a+b<0; }
function affM(f){ const o=f(0,0), a=f(1,0), b=f(0,1); return `matrix(${[a[0]-o[0],a[1]-o[1],b[0]-o[0],b[1]-o[1],o[0],o[1]].map(v=>+v.toFixed(3)).join(',')})`; }
function affA(f){ const o=f(0,0), a=f(1,0), b=f(0,1); return [a[0]-o[0],a[1]-o[1],b[0]-o[0],b[1]-o[1],o[0],o[1]]; }
function groundM(z){ return affM((u,v)=>P(u,v,z||0)); }
function wallM(ax,c,top){ return ax==='x'?affM((u,v)=>P(u,c,top-v)):affM((u,v)=>P(c,u,top-v)); }
// yüz üzerine yazı (hep soldan sağa okunur)
function faceText(ax,c,u0,len,z,txt,size,fill){ const p0=ax==='x'?P(u0,c,z):P(c,u0,z), p1=ax==='x'?P(u0+len,c,z):P(c,u0+len,z), rev=p1[0]<p0[0], a=rev?p1:p0, b=rev?p0:p1, sl=(b[1]-a[1])/Math.max(1e-6,b[0]-a[0]);
  return `<text transform="matrix(1,${sl.toFixed(3)},0,1,${(a[0]+2).toFixed(1)},${(a[1]+(sl>0?0.5:0)).toFixed(1)})" font-size="${size}" font-weight="800" fill="${fill}" letter-spacing=".3">${txt}</text>`; }
const pt=a=>a.map(p=>p[0].toFixed(1)+','+p[1].toFixed(1)).join(' ');
function shade(hex,f){ const n=parseInt(hex.slice(1),16); let r=n>>16,g=(n>>8)&255,b=n&255; r=Math.min(255,r*f)|0; g=Math.min(255,g*f)|0; b=Math.min(255,b*f)|0; return '#'+((1<<24)+(r<<16)+(g<<8)+b).toString(16).slice(1); }
function poly(pts,fill,extra=''){ return `<polygon points="${pt(pts)}" fill="${fill}" ${extra}/>`; }
function box(x,y,z,w,d,h,col,extra=''){
  const s='stroke="rgba(0,0,0,.35)" stroke-width=".6" stroke-linejoin="round" '+extra;
  if(VK){ const R=rectV(x,y,w,d); x=R.x; y=R.y; w=R.w; d=R.d; const Q=P0;
    return poly([Q(x,y+d,z),Q(x+w,y+d,z),Q(x+w,y+d,z+h),Q(x,y+d,z+h)],shade(col,0.70),s)+poly([Q(x+w,y,z),Q(x+w,y+d,z),Q(x+w,y+d,z+h),Q(x+w,y,z+h)],shade(col,0.86),s)+poly([Q(x,y,z+h),Q(x+w,y,z+h),Q(x+w,y+d,z+h),Q(x,y+d,z+h)],shade(col,1.07),s); }
  return poly([P(x,y+d,z),P(x+w,y+d,z),P(x+w,y+d,z+h),P(x,y+d,z+h)],shade(col,0.70),s)+
         poly([P(x+w,y,z),P(x+w,y+d,z),P(x+w,y+d,z+h),P(x+w,y,z+h)],shade(col,0.86),s)+
         poly([P(x,y,z+h),P(x+w,y,z+h),P(x+w,y+d,z+h),P(x,y+d,z+h)],shade(col,1.07),s);
}
// ön yüz üzerinde dikdörtgen: face 'f' (y+d düzlemi, u x yönünde) ya da 'r' (x+w düzlemi, u y yönünde)
function faceRect(x,y,w,d,face,u0,u1,z0,z1,fill,extra=''){
  const Q = face==='f' ? (u,z)=>P(x+u,y+d,z) : (u,z)=>P(x+w,y+u,z);
