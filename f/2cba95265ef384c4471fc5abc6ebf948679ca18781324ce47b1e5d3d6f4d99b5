function cmmRow(o){ const nd=cmmNeedMM(o); if(!nd) return ''; const ok=cmmOk(o), gNo=!ok&&o.big&&S.equip.some(e=>isGcmm(e.type)&&e.placed&&GCMMS[e.type].mx>=nd&&!gcmmLift(e,o)); return `<span>CMM şartı</span><span style="color:${ok?'var(--ok)':'var(--bad)'}">${ok?'✓':'✗'} ${nd.toLocaleString(NLOC)} mm hassas parça: ${cmmNeedTxt(o)}${gNo?` · <b>portal CMM'in bölgesinde en az ${craneNeedMeas(o)} t vinç yok</b> (parça vinçsiz tablaya konamaz)`:''}${ok?'':` <a onclick="event.stopPropagation();gotoQual('${nd>1200&&nd<=10000?'eq_gcmm':'eq_cmmlist'}')" style="text-decoration:underline;cursor:pointer">${nd>1200&&nd<=10000?'Portal CMM ›':'CMM ›'}</a>`}</span>`; }
function craneNeedMeas(o){ if(!o||!o.big) return 0; const t=partKg(o)*1.15/1000; const c=CRANES.find(x=>x.t>=t); return c?c.t:Math.ceil(t); }   // ölçüm için bitmiş parçayı kaldırmak yeter
function gcmmLift(e,o){ return !o||!o.big||craneCapFor(e)>=craneNeedMeas(o); }
function hasGcmm(o){ return S.equip.some(e=>isGcmm(e.type)&&e.placed&&gcmmLift(e,o))&&!cmmLate(); }
function cmmLbl(e){ const n=cmmInfo(e).n, same=S.equip.filter(x=>x.placed&&(x.type==='cmm'||isGcmm(x.type))&&cmmInfo(x).n===n); return 'CMM · '+n+(same.length>1&&same.includes(e)?` #${same.indexOf(e)+1}`:''); }
function cmmInfo(e){ if(e&&isGcmm(e.type)) return GCMMS[e.type]; return CMMS[(e&&e.cmmModel)||'mit_c']||CMMS.mit_c; }
function cmmPrice(k){ return CFG.prices['cmm_'+k]??CMMS[k].price; }
function cmmCal(k){ return Math.max(1500,Math.round(cmmPrice(k)*0.03/100)*100); }
