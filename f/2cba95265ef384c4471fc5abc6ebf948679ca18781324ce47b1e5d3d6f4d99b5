  const L=S.listings.find(l=>l.lid===lid); if(!L) return;
  const first=!S.shop, dep=L.rent*CFG.rentMult*2, move=first?0:moveCost(L);
  const cost=dep+move-curRefund(); if(S.money<cost){ toast('Para yetmiyor'); return; }
