function gPrice(k){ return CFG.prices['g_'+k]??GAUGES[k].price; }
function gPriceB(k,b){ const v=gPrice(k)*(GBR[b]?GBR[b].pm:1); return v<100?Math.round(v):Math.round(v/10)*10; }
