  return `<div class="card" style="border-color:#8a6a1f;background:#2a2412;margin:8px 0"><b>${g==='kap'?'💡 Banyo yetmiyor':'💡 Fırın yetmiyor'}</b><div class="sub" style="margin-top:4px">Kendi tesisine sığmayan büyük işler fasona gidiyor: ${u.pend} açık iş/teklif${u.past?`, son 120 günde ${u.past} iş · ${fmt$(u.lost)}`:''}. En uzun parça ${m(u.need)}, ${g==='kap'?'banyo':'fırın'} ${m(u.mx)}. Fasonda iş ${g==='kap'?'8–16':'6–12'} gün bekler ve tam fiyat ödenir; kendi tesisinde 1–2 gün, %45 ucuz.</div>
   <div class="row" style="margin-top:8px;gap:8px;flex-wrap:wrap"><span class="sub">Öneri: <b style="color:var(--ink)">${X.n}</b>${u.k!==u.tgt?`, ardından ${T.n}`:''}${u.fits?'':' · en büyük kademe, daha uzun parçalar yine fasona gider'}</span><button class="btn" onclick="facUp('${g}','${u.k}')" ${S.money<X.price?'disabled':''}>Peşin ${fmt$(X.price)}</button><button class="btn ghost" onclick="facUp('${g}','${u.k}',true)" ${S.money<facLoan(X.price).down?'disabled':''}>${facLoanTxt(X.price)}</button></div></div>`; }
function facUps(f){ return Object.keys(f.up||{}).filter(k=>f.up[k]).map(k=>FACX[k]).filter(Boolean); }
function facAge(f){ return 1+Math.min(0.6,Math.max(0,S.day-(f.since||S.day))/365*0.12); }
function facSalesAvg(f){ const F=FAC[f.k]; return ((F.sales[0]+F.sales[1])/2*(1+0.08*(f.extra||0))+facUps(f).reduce((a,u)=>a+(u.sales[0]+u.sales[1])/2,0))*facAge(f); }
function facOpex(f){ return Math.round(FAC[f.k].opex+facUps(f).reduce((a,u)=>a+u.opex,0)+(f.extra||0)*1100*(econ().wage||1)); }
function facMaxLen(f){ const base=f.k==='kaplama'?1200:f.k==='isil'?1500:99999; return Math.max(base,...facUps(f).map(u=>u.len||0)); }
function bigDim(o){ return Math.max(o.L||0,o.W||0,o.H||0,o.dia||0); }
function facUp(g,k,credit){ const f=facS()[g], X=FACX[k]; if(!f||!X||(f.up&&f.up[k])) return; if(X.need&&!(f.up&&f.up[X.need])){ toast('Önce '+FACX[X.need].n); return; } if(X.needK&&f.k!==X.needK){ toast('Önce '+FAC[X.needK].n+' kademesine büyüt'); return; } const pay=credit?facLoan(X.price).down:X.price; if(S.money<pay){ toast('Para yetmiyor'); return; }
  cash(-pay,credit?'Tesis yatırımı (peşinat)':'Tesis yatırımı',X.n); if(credit) facCredit(X.n,X.price); (f.up=f.up||{})[k]=S.day; syncPlant(); toast(`🏭 ${X.n} kuruldu${credit?` · kredi: 60 ay × ${fmt$(facLoan(X.price).monthly)}`:''}`); saveAll(); render(); }
