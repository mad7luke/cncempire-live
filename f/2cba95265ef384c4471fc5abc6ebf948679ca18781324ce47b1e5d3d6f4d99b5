// gerekli kişi: kapasiteye göre (gece vardiyası ve robotlu makine daha çok parça çıkarır); küçük atölyede yarım kişilik işi patron yapar
function postNeedN(r){ const c=myMach(); let n=c<=2?0:r==='tesviye'?Math.floor(c/2):Math.floor(c/4);
  for(const k of (S.contracts||[]).filter(k=>k.mass&&k.st==='aktif')){ const [tv,pk]=massPostH(k.spec,k.lotQty,k.hrs||k.lotQty*((k.spec.cam||3)*0.8+(k.spec.bag||1)*0.25)/60); n+=Math.ceil(massPeople(r==='tesviye'?tv:pk)); }
  return n; }
function tvPer(cyc){ return Math.min(12,0.5+0.3*Math.max(0.2,cyc)); }                 // parça başı tesviye dk (çevrim süresine göre)
function pkPer(o){ return 0.25+Math.min(3,partKg(o)*0.08); }                             // parça başı paketleme dk (ağırlığa göre)
function postFull(o,st,mm){ const q=Math.max(1,o.qty||1); mm=mm??(o.machMin||((o.cam||5)*q)); return st==='tesviye'?Math.round(q*tvPer(mm/q)):Math.round(8+q*pkPer(o)+Math.ceil(partKg(o)*q/400)*6); }
const CAT_KW={}; function catKW(c){ if(CAT_KW[c]==null){ const ks=Object.keys(MODELS).filter(k=>MODELS[k].cat===c); CAT_KW[c]=ks.length?ks.reduce((a,k)=>a+MODELS[k].kw,0)/ks.length:15; } return CAT_KW[c]; }
function flatH(c){ const w0=econ().wage||1, wc=ctry().w, w=w0/wc*(1+0.6*(wc-1)), wI=w0/wc*(1+0.3*(wc-1)), opd=(ROLES.op.base+600)/176, hv=HEAVY_CATS.includes(c), prem=hv?(CFG.opPremH??900):(c==='mill5'||c==='millturn')?(CFG.opPrem5??450):0;
  return 0.8*(opd*1.0*w+prem*1.25/176*w+catKW(c)*0.6*kwhP()+(hv?4500:2500)*12/5475*wI)*modeK('priceMul'); }
function opHourAdd(){ return opPer()===1?(ROLES.op.base+1.0*600)/176*0.5*(econ().wage||1)/ctry().w*(1+0.6*(ctry().w-1)):0; }
function postPriceAdd(p){ const q=p.qty||1; return (q*tvPer(p.cam||5)*0.065+q*pkPer(p)*0.035+q*0.1+partKg(p)*q*0.04+Math.ceil(partKg(p)*q/400)*12+(p.big?250*q:0))*(econ().price||1)*(1+0.5*(ctry().w-1)); }
function firmFirst(){ return CFG.firmFirst!==false; }
// üretim önceliği: öncelikli (acil/sözleşme) iş > firma işi > piyasa işi; aynı sınıfta termin sırası
function oRank(o){ return o.prio?2:(o.firm&&firmFirst())?1:0; }
function postQueue(st){ return S.orders.filter(o=>o.st===st&&!(st==='tesviye'&&o.tvOut)).sort((a,b)=>oRank(b)-oRank(a)||a.due-b.due); }
