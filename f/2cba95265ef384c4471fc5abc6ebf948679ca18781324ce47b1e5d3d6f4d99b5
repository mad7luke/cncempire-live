function sellItem(id){
  const m=mGet(id), e=eGet(id);
  if(m&&(m.cur||m.queue.length)){ toast('Makinede iş var'); return; }
  if((m&&m.lease)||(e&&e.lease)){ toast('Leasing bitmeden satılamaz'); return; }   if(m&&m.pledge){ toast('Makine bankaya rehinli: önce krediyi kapat'); return; }
  if(e&&isKoda(e.type)&&roomCmm(e)){ const cs=roomCmms(e), rs=S.equip.filter(r=>r!==e&&isKoda(r.type)&&r.placed).sort((a,b)=>roomCap(b)-roomCap(a)), free=rs.reduce((a,r)=>a+Math.max(0,roomCap(r)-roomCmms(r).length),0);
    if(free<cs.length){ toast(`İçinde ${cs.length} CMM var, diğer kalite odalarında ${free} boş yer var: önce daha büyük oda kur`); return; }
    const to=new Set(); for(const c of cs){ const r=rs.find(r=>roomCmms(r).length<roomCap(r)); const i=cmmSlot(r,c); c.room=r.id; Object.assign(c,cmmSpot(r,i)); to.add(EQUIP[r.type].name); }
    toast(`🧪 ${cs.length} CMM ${[...to].join(', ')} içine taşındı`); }
  const v=sellValue(m||e); cash(v,'Satış',m?MODELS[m.model].name:EQUIP[e.type].name);
  if(m) S.machines=S.machines.filter(x=>x!==m); else S.equip=S.equip.filter(x=>x!==e);
  closeSheet(); toast(`İkinci ele satıldı: ${fmt$(v)}`); saveAll(); render();
}
function depF(a){ return a<1?0.8-0.05*a:Math.max(0.15,0.75-0.05*(a-1)); }
function machAge(o){ return Math.max(0,(S.day-(o.since??0))/365); }
function machValue(o){ const v=o.value||CFG.prices[o.model], a=machAge(o); if(o.cond==='Sıfır'||!o.year) return v*depF(a); const a0=Math.max(0,2026-o.year); return v*depF(a0+a)/depF(a0); }
function sellValue(o){ return Math.round(o.model?machValue(o)+(o.auto?autoPrice(o.auto)*0.4:0):o.type==='cmm'?cmmPrice(o.cmmModel||'mit_c')*0.5:CFG.prices[o.type]*0.5); }
function buyUpgrade(k){ if(S.upgrades[k]) return; S.upgrades[k]=true; toast('Gece vardiyası başladı'); opShiftBalance(); saveAll(); render(); }
function stopNight(){ S.upgrades.night=false; toast('Gece vardiyası durduruldu · mesai 08:00–18:00'); opShiftBalance(); saveAll(); render(); }

