    else if(pts.size===2){ const [a,b]=[...pts.values()]; g={pinch:true,d:Math.hypot(a.x-b.x,a.y-b.y)||1,s:VW.s,tx:VW.tx,ty:VW.ty,cx:(a.x+b.x)/2,cy:(a.y+b.y)/2}; lastTap=0; } });
  st.addEventListener('pointermove',e=>{ if(!pts.has(e.pointerId)||!VW) return; pts.set(e.pointerId,{x:e.clientX,y:e.clientY}); if(!g) return;
    if(g.pinch){ if(pts.size<2) return; const [a,b]=[...pts.values()]; vwZoomAt(g.s*Math.hypot(a.x-b.x,a.y-b.y)/g.d,g.cx,g.cy,g); return; }
    const dx=e.clientX-g.x, dy=e.clientY-g.y; if(Math.abs(dx)+Math.abs(dy)>6) lastTap=0;
